# =============================================
# VARIABLES DE ENTORNO — Agente Mr. Sushi
# Copia este archivo como .env y llena los valores
# =============================================

# Groq (IA)
GROQ_API_KEY=tu_groq_api_key_aqui

# Twilio (WhatsApp + Llamadas)
TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# Numero de WhatsApp del dueno (Diego), para alertas en tiempo real cuando
# falla Netpay, Uber Direct o Google Maps en un pedido real. Con lada, sin
# espacios ni "whatsapp:" (ej. 5511223344). Ver src/utils/alertas.js
TELEFONO_DUENO=tu_numero_aqui

# URL del servidor (Railway)
BASE_URL=https://agente-japones-production.up.railway.app

# Puerto
PORT=8080

# Integración con el POS de Grupo Telnet (ticket 219646): manda cada pedido
# pagado/confirmado directo a la caja de la sucursal. Las entrega Grupo
# Telnet por un canal seguro -- NUNCA deben escribirse en el código ni
# compartirse por chat. Mientras estas 4 variables no estén configuradas, la
# integración simplemente no hace nada (no rompe ni afecta el resto del
# bot). Ver src/utils/telnet_pos.js. Además, cada sucursal necesita su
# número de sucursal en Telnet y activarse desde Administración → Sucursales
# en el dashboard antes de que se le manden pedidos.
TELNET_URL=https://tu-url-de-telnet-aqui/pedidosenlinea/
TELNET_USUARIO=tu_usuario_telnet_aqui
TELNET_PASSWORD=tu_password_telnet_aqui
TELNET_CLAVE_BD=tu_claveBaseDeDatos_telnet_aqui
